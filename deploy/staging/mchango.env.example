# Server settings for Mchango on schul-staging. No secrets belong here.
#
# deploy.yml copies this file to /opt/mchango/mchango.env ONLY if that file does
# not exist yet, so edits made on the server survive later deploys. After
# changing it on the server, apply with:
#   docker compose -p mchango -f /opt/mchango/compose.yml up -d
#
# Paths and listener addresses are fixed in compose.yml; do not set them here.

# The public page's address, used in og:url / og:image / canonical tags and in
# WhatsApp updates and PDF statements. Leave empty until the public site is
# live, then set it to the Netlify site's URL (e.g. https://<site>.netlify.app
# or the custom domain), NOT the backend hostname.
PUBLIC_URL=

# Extra host names allowed to open management (comma-separated). The SSH tunnel
# uses 127.0.0.1 / localhost, which are always allowed, so leave this empty.
MANAGE_ALLOWED_HOSTS=

MAX_UPLOAD_MB=10
PDF_TIMEOUT_SECS=30
LOG_FORMAT=json
RUST_LOG=info,sqlx=warn
