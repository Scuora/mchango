# Copy to .env and adjust. Never commit .env.
#
# ---- Running directly (cargo run, from backend/) -------------------------------
# Paths are relative to backend/. Keep data outside the source tree in production.
DATABASE_PATH=../data/mchango.sqlite
UPLOADS_DIR=../data/uploads
STATIC_DIR=../frontend/dist
PUBLIC_ADDR=127.0.0.1:8080
# Management requires sign-in, and should still stay on loopback or a private/VPN address.
MANAGE_ADDR=127.0.0.1:8081
# Extra host names allowed to open management (e.g. a Tailscale name), comma-separated.
MANAGE_ALLOWED_HOSTS=
# Poppler's pdftotext, used to read statement PDFs.
PDFTOTEXT_PATH=pdftotext
PDF_TIMEOUT_SECS=30
MAX_UPLOAD_MB=10
# The public page's address, used in WhatsApp updates.
PUBLIC_URL=
LOG_FORMAT=text
RUST_LOG=info,sqlx=warn

# ---- Docker Compose (docker compose up) ---------------------------------------
# File names inside the data volume. Use other names for a separate demo database.
MCHANGO_DB=mchango.sqlite
MCHANGO_UPLOADS=uploads
PUBLIC_BIND=127.0.0.1
PUBLIC_PORT=8080
MANAGE_BIND=127.0.0.1
MANAGE_PORT=8081
# For HTTPS with Caddy (docker compose --profile https up -d):
DOMAIN=
# Optional HTTPS address for management (see deploy/Caddyfile). Also add it to MANAGE_ALLOWED_HOSTS.
ADMIN_DOMAIN=
